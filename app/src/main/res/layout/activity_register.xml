<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="24dp" android:gravity="center">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registro EduTools" android:textSize="22sp" android:textStyle="bold"/>
 <EditText android:id="@+id/etUserReg" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nuevo usuario" android:layout_marginTop="16dp"/>
 <EditText android:id="@+id/etPassReg" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Contraseña" android:inputType="textPassword"/>
 <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REGISTRARSE" android:layout_marginTop="16dp"/>
 <TextView android:id="@+id/tvMsgReg" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp"/>
</LinearLayout>
